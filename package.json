{
  "name": "lemmeteach",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "LemmeTeach — a subscription AI tutor that teaches on a live whiteboard.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -b",
    "vendor:pyodide": "node scripts/vendor-pyodide.mjs",
    "vendor:fonts": "node scripts/vendor-fonts.mjs"
  },
  "dependencies": {
    "idb-keyval": "^6.2.1",
    "katex": "^0.16.11",
    "mathjs": "^13.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shiki": "^1.22.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/node": "^26.4.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.13.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
