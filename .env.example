# LemmeTeach configuration (CLAUDE.md §24).
#
# Set these in the Vercel dashboard under Settings → Environment Variables.
# For local work, copy this file to .env.local — it is ignored by git.
# With none of them set, the site still builds and runs as demo-only.

# --- Server only. Never prefix these with VITE_ and never commit real values. ---

# OpenRouter management key: creates and caps each subscriber's key.
OPENROUTER_MANAGEMENT_KEY=

# Lemon Squeezy: the webhook signing secret, and your store id.
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_STORE_ID=

# Lemon Squeezy variant id of each plan.
LEMON_VARIANT_STARTER=
LEMON_VARIANT_REGULAR=
LEMON_VARIANT_INTENSIVE=

# --- Public, baked into the build. These are just links. ---

# Lemon Squeezy checkout URL of each plan.
VITE_CHECKOUT_STARTER=
VITE_CHECKOUT_REGULAR=
VITE_CHECKOUT_INTENSIVE=

# Optional: where "Manage subscription" goes. Defaults to Lemon Squeezy's
# customer page.
VITE_BILLING_PORTAL_URL=
