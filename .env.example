# LemmeTeach configuration (CLAUDE.md §24).
#
# Set these in the Vercel dashboard under Settings → Environment Variables.
# For local work, copy this file to .env.local — it is ignored by git.
# With none of them set, the site still builds and runs as demo-only.

# --- Server only. Never prefix these with VITE_ and never commit real values. ---

# OpenRouter management key: creates and caps each subscriber's key.
OPENROUTER_MANAGEMENT_KEY=

# Paddle: `sandbox` while testing, `production` when live.
PADDLE_ENV=sandbox
# Paddle API key (Developer tools → Authentication). Sandbox keys start pdl_sdbx_.
# Read-only permissions are enough: transactions and subscriptions.
PADDLE_API_KEY=
# The secret of the webhook destination pointed at https://<site>/api/webhook
# (Developer tools → Notifications). Starts pdl_ntfset_.
PADDLE_WEBHOOK_SECRET=

# Paddle price id of each plan (pri_…). Sandbox and live ids differ.
PADDLE_PRICE_STARTER=
PADDLE_PRICE_REGULAR=
PADDLE_PRICE_INTENSIVE=

# The store behind usage counts and shared links (Upstash Redis). Adding it
# from the Vercel marketplace sets these two for you. Optional: without it, the
# site still runs and sharing and counting are off.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Any long random string. Lets you read your numbers from /api/stats.
STATS_TOKEN=

# --- Public, baked into the build. Safe to expose. ---

# Paddle client-side token (Developer tools → Authentication → Client-side
# tokens). Sandbox tokens start test_, live ones live_.
VITE_PADDLE_CLIENT_TOKEN=
VITE_PADDLE_ENV=sandbox

# The same price ids again, for opening checkout in the browser.
VITE_PADDLE_PRICE_STARTER=
VITE_PADDLE_PRICE_REGULAR=
VITE_PADDLE_PRICE_INTENSIVE=

# Optional: your Paddle customer portal link (Checkout → Customer portal),
# where "Manage subscription" goes. Without it, learners are pointed to the
# link in Paddle's receipt email.
VITE_BILLING_PORTAL_URL=
